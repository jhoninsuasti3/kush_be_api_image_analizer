# ============================================================================
# APP CONFIGURATION
# ============================================================================
# Application environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode (verbose logging, detailed error messages)
DEBUG=true

# Application name
APP_NAME=Kush Image Analyzer API

# ============================================================================
# AWS CONFIGURATION
# ============================================================================
# AWS Region for all services (Lambda, DynamoDB, CloudWatch)
AWS_REGION=us-east-1

# AWS Credentials
# - For Docker/local development: use "dummy" values
# - For AWS Lambda: leave empty (IAM roles will be used)
# - For production: use real credentials or AWS SSM parameters
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy

# DynamoDB Users Table Name
DYNAMODB_USERS_TABLE=kush-users-dev

# DynamoDB Image Analysis Table Name
DYNAMODB_ANALYSIS_TABLE=kush-image-analysis-dev

# DynamoDB Endpoint
# - For Docker: http://dynamodb-local:8000
# - For local development (without Docker): http://localhost:8001
# - For production: leave empty to use AWS DynamoDB
DYNAMODB_ENDPOINT_URL=http://localhost:8001

# ============================================================================
# GOOGLE CLOUD VISION CONFIGURATION
# ============================================================================
# Path to Google Cloud service account JSON file
# - For Docker: ./credentials/google-vision-credentials.json (will be mounted)
# - For local development: ./credentials/google-vision-credentials.json
# - For production: use AWS Secrets Manager or environment variable with JSON content
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-vision-credentials.json

# Alternative: Google Cloud Project ID (if using default credentials)
# GOOGLE_CLOUD_PROJECT=your-project-id

# Alternative: Google API Key (less secure, not recommended for production)
# GOOGLE_API_KEY=your-api-key

# Note: Place your Google Cloud credentials JSON file in the credentials/ folder
# If GOOGLE_APPLICATION_CREDENTIALS is not set, the app will still work
# but image analysis will fail. This is useful for testing auth endpoints only.

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Secret key for signing JWT tokens (CHANGE THIS IN PRODUCTION!)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# JWT algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# FILE UPLOAD LIMITS
# ============================================================================
# Maximum file size in megabytes
MAX_FILE_SIZE_MB=5

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Structured logging format: json | console
LOG_FORMAT=json

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Allowed origins for CORS (comma-separated)
# Use "*" for development only, specify exact origins in production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# OBSERVABILITY (Optional)
# ============================================================================
# Sentry DSN for error tracking (leave empty to disable)
SENTRY_DSN=

# Sentry environment
SENTRY_ENVIRONMENT=development

# Sentry traces sample rate (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
# Enable API documentation (Swagger UI and ReDoc)
ENABLE_DOCS=true

# API docs URL path
DOCS_URL=/docs
REDOC_URL=/redoc